# ═══════════════════════════════════════════════════════════════════
#  AUTH
# ═══════════════════════════════════════════════════════════════════
SECRET=your_jwt_signing_secret_here

# ═══════════════════════════════════════════════════════════════════
#  EMAIL — SENDGRID
# ═══════════════════════════════════════════════════════════════════
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ═══════════════════════════════════════════════════════════════════
#  SMS — TWILIO
# ═══════════════════════════════════════════════════════════════════
TWILIOSID=your_twilio_account_sid_here
TWILIOTOKEN=your_twilio_auth_token_here

# ═══════════════════════════════════════════════════════════════════
#  PAYMENTS — STRIPE
# ═══════════════════════════════════════════════════════════════════
STRIPE=your_stripe_secret_key_here

# ═══════════════════════════════════════════════════════════════════
#  AWS S3 (product/document uploads)
# ═══════════════════════════════════════════════════════════════════
S3ACCESSKEY=your_aws_access_key_here
S3SECRETKEY=your_aws_secret_key_here

# ═══════════════════════════════════════════════════════════════════
#  CLOUDINARY
#  NOTE: this account (cloud_name dwfqzydum) is shared with
#  foodengo_server -- rotating the secret here requires updating BOTH
#  repos at the same time, or image uploads will break in whichever
#  one still has the old value.
# ═══════════════════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=dwfqzydum
CLOUDINARY_API_KEY=818339153567867
CLOUDINARY_API_SECRET=your_new_rotated_secret_here

# ═══════════════════════════════════════════════════════════════════
#  MAPS — MAPBOX
#  Previously hardcoded in two separate files (storeAddress.js and
#  transaction.js) with duplicated getLatLong() logic; now
#  consolidated into a single shared helper in utility/global.js.
# ═══════════════════════════════════════════════════════════════════
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# ═══════════════════════════════════════════════════════════════════
#  DATABASE
#  NOTE: not directly observed in the files reviewed today, but every
#  Mongoose-based backend in this project family uses this variable
#  name -- confirm the actual name matches what index.js/app.js expects.
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/eh_halal_db?retryWrites=true&w=majority
